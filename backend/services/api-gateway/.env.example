NODE_ENV=development
LOG_LEVEL=info
PORT=4000
SERVICE_TOKEN=change-me-internal-service-token
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rec
DB_PASSWORD=rec-dev-password
DB_NAME=auth_db
DB_POOL_MAX=10
JWT_SECRET=change-me-to-a-long-random-secret-of-32-plus-chars
JWT_EXPIRES_IN_SECONDS=3600
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
VOICE_MAX_BODY=1mb
OCR_MAX_BODY=2mb
VOICE_TIMEOUT_MS=10000
AI_TIMEOUT_MS=20000
SESSION_SERVICE_URL=http://127.0.0.1:4001
ELIGIBILITY_SERVICE_URL=http://127.0.0.1:4002
SCHEME_SERVICE_URL=http://127.0.0.1:4003
AI_SERVICE_URL=http://127.0.0.1:4004
VOICE_SERVICE_URL=http://127.0.0.1:4005
OCR_SERVICE_URL=http://127.0.0.1:4006
# Used only by `npm run db:seed` to create the first admin account.
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=change-me-admin-password
