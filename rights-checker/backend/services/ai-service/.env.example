NODE_ENV=development
LOG_LEVEL=info
PORT=4004
SERVICE_TOKEN=change-me-internal-service-token
ELIGIBILITY_SERVICE_URL=http://127.0.0.1:4002
SCHEME_SERVICE_URL=http://127.0.0.1:4003
# LLM_PROVIDER=groq   (auto: groq when GROQ_API_KEY is set, otherwise mock)
# Groq (https://console.groq.com/keys). With a key, LLM_PROVIDER defaults to groq.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_MS=15000
