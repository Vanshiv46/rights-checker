# Copy to backend/.env for `docker compose up` (Docker reads this file automatically).
# One Groq key powers AI explanations AND voice (Whisper speech-to-text): https://console.groq.com/keys
GROQ_API_KEY=
# Admin login created on first start
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=change-me-admin-password
