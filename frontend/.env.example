# Base URL of the api-gateway (the frontend only talks to /v1 on this host).
# The gateway must list this app's origin in CORS_ORIGINS (default: http://localhost:5173,http://localhost:4173).
VITE_API_URL=http://localhost:4000
# true = use the built-in mock API (no backend needed); false = real backend
VITE_USE_MOCK=false
