NODE_ENV=development
LOG_LEVEL=info
PORT=4005
SERVICE_TOKEN=change-me-internal-service-token
# Groq Whisper speech-to-text (same key as ai-service: https://console.groq.com/keys).
# Leave empty to run without voice: /transcribe then returns 503 VOICE_UNAVAILABLE.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
VOICE_TIMEOUT_MS=10000
VOICE_MAX_BODY=1mb
